# Salin file ini ke .env (lokal) atau isi langsung di Railway > Variables / panel Pengaturan.
BOT_TOKEN=          # token dari @BotFather, contoh 123456:AAF...
ADMIN_ID=           # Telegram user ID admin (dapat dari @userinfobot) — id ini TIDAK perlu verifikasi saluran
ADMIN_PASSWORD=     # password login web admin controller
GEMINI_API_KEY=     # opsional: API key Google AI Studio (AIza...) dari aistudio.google.com/apikey

# --- ALTERNATIF AI MUDAH (tanpa Gemini) — cukup salah satu jalur di bawah ---
AI_API_KEY=         # OpenRouter GRATIS: openrouter.ai/keys → key sk-or-... (deteksi otomatis)
                    # bisa juga: Groq gsk_... (console.groq.com/keys, gratis + vision)
                    # atau: DeepSeek sk-... (platform.deepseek.com, teks saja)
AI_PROVIDER=        # opsional: groq / deepseek / openrouter / custom (kosong = deteksi otomatis dari awalan key)
AI_BASE_URL=        # hanya untuk AI_PROVIDER=custom, contoh https://api.groq.com/openai/v1
AI_TEXT_MODEL=      # opsional override model teks (bawaan OpenRouter: nvidia/nemotron-3-ultra-550b-a55b:free)
AI_VISION_MODEL=    # opsional override model vision (bawaan OpenRouter: nvidia/nemotron-3.5-super-vl:free)
AI_FALLBACK_MODELS= # opsional: daftar model cadangan dipisah koma; kosong = bawaan per provider
                    # catatan: hindari model google/* di OpenRouter untuk wilayah Indonesia (geo-block)

NETLIFY_TOKEN=      # personal access token Netlify untuk deploy website
WA_CHANNEL_LINK=    # link saluran WhatsApp wajib follow
BOT_AUTOSTART=true  # bot langsung jalan saat service dinyalakan
